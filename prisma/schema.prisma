generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  bio       String?
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Technology {
  id    Int    @id @default(autoincrement())
  name  String @unique
}

model Project {
  id            Int     @id @default(autoincrement())
  title         String
  description   String
  repositoryUrl String
  profileId     Int
  profile       Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}model Profile {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  bio       String?
  projects  Project[]
}

model Technology {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  projects Project[] @relation("ProjectTechnologies")
}

model Project {
  id            Int          @id @default(autoincrement())
  title         String
  description   String?
  repositoryUrl String?
  profileId     Int
  profile       Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  technologies  Technology[] @relation("ProjectTechnologies")
  feedbacks     Feedback[]   // <--- Adicionado: Relação 1:N com Feedback
}

// ---> Adicionar o model Feedback abaixo:
model Feedback {
  id        Int      @id @default(autoincrement())
  comment   String
  rating    Int
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}