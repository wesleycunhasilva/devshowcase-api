generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  bio       String?
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Technology {
  id    Int    @id @default(autoincrement())
  name  String @unique
}

model Project {
  id            Int     @id @default(autoincrement())
  title         String
  description   String
  repositoryUrl String
  profileId     Int
  profile       Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}